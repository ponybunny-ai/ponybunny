{
  "mcpServers": {
    "fs": {
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/nickma/Develop/nick-ma/pony"
      ],
      "allowedTools": [
        "*"
      ],
      "autoReconnect": true,
      "timeout": 30000
    },
    "companies_house_mcp": {
      "enabled": false,
      "transport": "http",
      "url": "https://mcp.dho.ai/dho/companies-house/mcp",
      "allowedTools": [
        "*"
      ],
      "autoReconnect": true,
      "timeout": 30000
    },
    "ico_mcp": {
      "enabled": false,
      "transport": "http",
      "url": "https://mcp.dho.ai/dho/ico/mcp",
      "allowedTools": [
        "*"
      ],
      "autoReconnect": true,
      "timeout": 30000
    },
    "pg": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://pony:pony_pass@localhost:15432/ponybunny"
      ],
      "allowedTools": [
        "*"
      ],
      "autoReconnect": true,
      "timeout": 60000
    },
    "playwright": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "allowedTools": [
        "browser_navigate",
        "browser_screenshot",
        "browser_click",
        "browser_type",
        "browser_evaluate",
        "browser_select_option",
        "browser_hover",
        "browser_drag",
        "browser_press_key",
        "browser_close"
      ],
      "autoReconnect": true,
      "timeout": 60000
    }
  }
}