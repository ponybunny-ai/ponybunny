{
  "$schema": "https://ponybunny.dho.ai/schemas/llm-config.schema.json",
  "providers": {
    "anthropic": {
      "enabled": true,
      "protocol": "anthropic",
      "type": "api",
      "baseUrl": "https://api.anthropic.com/v1/messages",
      "priority": 1
    },
    "openai": {
      "enabled": true,
      "protocol": "openai",
      "type": "api",
      "baseUrl": "https://api.openai.com/v1",
      "priority": 1
    },
    "aws-bedrock": {
      "enabled": false,
      "protocol": "anthropic",
      "type": "api",
      "region": "us-east-1",
      "priority": 2,
      "costMultiplier": 1
    },
    "azure-openai": {
      "enabled": false,
      "protocol": "openai",
      "type": "api",
      "priority": 2
    },
    "openai-compatible": {
      "enabled": false,
      "protocol": "openai",
      "type": "api",
      "priority": 3
    },
    "openai-codex": {
      "enabled": false,
      "protocol": "codex",
      "type": "oauth",
      "priority": 1
    },
    "google-ai-studio": {
      "enabled": false,
      "protocol": "gemini",
      "type": "api",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "priority": 1
    },
    "google-vertex-ai": {
      "enabled": false,
      "protocol": "gemini",
      "type": "api",
      "priority": 2
    }
  },
  "models": {
    "anthropic": {
      "claude-sonnet-4-5-20250929": {
        "displayName": "Claude Sonnet 4.5",
        "costPer1kTokens": { "input": 0.003, "output": 0.015 },
        "maxContextTokens": 200000,
        "capabilities": ["text", "vision", "function-calling"]
      }
    },
    "openai": {
      "gpt-5.2": {
        "displayName": "GPT-5.2",
        "endpoints": [{ "name": "responses", "url": "/v1/responses" }],
        "costPer1kTokens": { "input": 0.01, "output": 0.03 },
        "maxContextTokens": 128000,
        "capabilities": ["text", "vision", "function-calling", "json-mode"]
      }
    },
    "openai-codex": {
      "gpt-5.2-codex": {
        "displayName": "GPT-5.2 Codex (OAuth)",
        "endpoints": [{ "name": "responses", "url": "/v1/responses" }],
        "costPer1kTokens": { "input": 0.01, "output": 0.03 },
        "maxContextTokens": 128000,
        "capabilities": ["text", "function-calling"]
      }
    },
    "openai-compatible": {
      "qwen2.5-coder-32b": {
        "displayName": "Qwen2.5 Coder 32B",
        "endpoints": [{ "name": "responses", "url": "/v1/responses" }],
        "costPer1kTokens": { "input": 0, "output": 0 },
        "maxContextTokens": 131072,
        "capabilities": ["text", "function-calling"]
      }
    }
  },
  "providerAliases": {
    "anthropic": { "protocol": "anthropic", "providers": ["anthropic"] },
    "openai": { "protocol": "openai", "providers": ["openai"] },
    "compat": { "protocol": "openai", "providers": ["openai-compatible"] },
    "codex": { "protocol": "codex", "providers": ["openai-codex"] }
  },
  "tiers": {
    "simple": {
      "primary": "anthropic.claude-sonnet-4-5-20250929",
      "fallback": ["openai.gpt-5.2"]
    },
    "medium": {
      "primary": "openai.gpt-5.2",
      "fallback": ["anthropic.claude-sonnet-4-5-20250929"]
    },
    "complex": {
      "primary": "openai.gpt-5.2",
      "fallback": ["anthropic.claude-sonnet-4-5-20250929", "openai-codex.gpt-5.2-codex"]
    }
  },
  "workloads": {
    "input-analysis": { "tier": "simple", "description": "Intent and emotion analysis" },
    "planning": { "tier": "complex", "description": "Goal decomposition and planning" },
    "execution": { "tier": "medium", "description": "ReAct execution loop" },
    "verification": { "tier": "medium", "description": "Result verification" },
    "response-generation": { "tier": "simple", "description": "Natural language response" },
    "conversation": { "tier": "medium", "description": "Conversation agent" }
  },
  "defaults": {
    "timeout": 120000,
    "maxTokens": 4096,
    "maxRetries": 2,
    "retryDelayMs": 1000,
    "temperature": 0.7
  }
}
