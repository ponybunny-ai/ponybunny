{
  "$schema": "https://ponybunny.dho.ai/schemas/llm-config.schema.json",
  "providers": {
    "openai-compatible": {
      "enabled": true,
      "protocol": "openai",
      "baseUrl": "http://localhost:8000/v1",
      "priority": 1
    }
  },
  "models": {
    "openai-compatible": {
      "qwen3-30b-a3b-instruct": {
        "displayName": "Qwen3 30B A3B Instruct",
        "providers": ["openai-compatible"],
        "endpoints": [
          { "name": "responses", "url": "/v1/responses" }
        ],
        "costPer1kTokens": { "input": 0, "output": 0 },
        "maxContextTokens": 32768,
        "capabilities": {
          "input": ["text"],
          "output": ["text"]
        },
        "features": ["function_calling"]
      }
    }
  },
  "providerAliases": {
    "openai-compatible": {
      "protocol": "openai",
      "providers": ["openai-compatible"]
    }
  },
  "tiers": {
    "simple": { "primary": "openai-compatible.qwen3-30b-a3b-instruct" },
    "medium": { "primary": "openai-compatible.qwen3-30b-a3b-instruct" },
    "complex": { "primary": "openai-compatible.qwen3-30b-a3b-instruct" }
  },
  "workloads": {
    "conversation": {
      "tier": "medium",
      "llm_model": "openai-compatible.qwen3-30b-a3b-instruct"
    }
  },
  "defaults": {
    "timeout": 120000,
    "maxTokens": 4096,
    "maxRetries": 2,
    "retryDelayMs": 1000,
    "temperature": 0.7
  }
}
